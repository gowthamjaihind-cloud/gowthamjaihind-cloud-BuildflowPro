# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# URL for the bot to receive webhook updates (Highly recommended for serverless/Cloud Run environments)
# Example: https://your-app-domain.com
TELEGRAM_WEBHOOK_URL=

# The ID of the project the bot should interact with by default
# (You can also implement project selection in the bot later)
DEFAULT_PROJECT_ID=your_project_id_here

TELEGRAM_WEBHOOK_SECRET_TOKEN=
