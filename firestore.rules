rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Role helpers (unchanged semantics): a caller has a role if either their
    // auth-token custom claim OR their users/{uid} profile carries that role.
    // ---------------------------------------------------------------------
    function hasAnyRole(roles) {
      return request.auth != null && (
        request.auth.token.role in roles ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles
      );
    }
    function isAdminOrManager() {
      return hasAnyRole(['Admin', 'Project Manager', 'Project Director', 'Owner']);
    }
    function isSiteEngineer() {
      return hasAnyRole(['Site Engineer']);
    }

    // ---------------------------------------------------------------------
    // Multi-tenant isolation.
    //
    // Membership lives as a map on the org document: members: { <uid>: <role> }.
    // A caller may only touch an org's data if their uid is a key in that map.
    // This is the wall between customers — without it, any signed-in user could
    // read or write ANY organization's data.
    //
    // Bootstrapping: an org with no members yet may be "claimed" once — the
    // claimer writes ONLY themselves in as 'Owner'. After that, only members can
    // change membership (via an admin-member settings write). This lets the
    // first owner seed themselves without a console edit and without leaving the
    // org open to a stranger claiming an already-owned org.
    // ---------------------------------------------------------------------
    function orgMembersById(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.get('members', {});
    }
    function isOrgMember(orgId) {
      return request.auth != null && (request.auth.uid in orgMembersById(orgId));
    }
    // Variants that read the org doc currently in scope (rules ON the org doc
    // itself) so we don't pay for an extra get().
    function thisOrgMembers() {
      return resource.data.get('members', {});
    }
    function isMemberOfThisOrg() {
      return request.auth != null && (request.auth.uid in thisOrgMembers());
    }
    function thisOrgUnclaimed() {
      return thisOrgMembers().size() == 0;
    }
    // The ONLY org-document fields a client may write. Everything else on an
    // org -- plan, subscriptionStatus, trialEndsAt, currentPeriodEnd,
    // includedProjects, userLimit, aiQuota, overageRate, pendingPayment,
    // Razorpay ids -- is billing state, written by Cloud Functions (Admin SDK)
    // after a verified payment, and read by those functions to decide what an
    // org may do. It was client-writable: any Owner could open the browser
    // console and set subscriptionStatus "active" and a bigger plan for free.
    // An allowlist, not a denylist, so a billing field added later is closed
    // by default. scripts/rules-escalation-probe.mjs covers this.
    function orgClientKeys() {
      return ['companyName', 'gstin', 'stateCode', 'members'];
    }
    function isValidClaim() {
      return request.auth != null
        && thisOrgUnclaimed()
        && request.resource.data.get('members', {}).keys().hasOnly([request.auth.uid])
        && (request.auth.uid in request.resource.data.get('members', {}))
        && request.resource.data.members[request.auth.uid] == 'Owner';
    }

    // ---------------------------------------------------------------------
    // Per-project access.
    //
    // An Owner or Admin grants each other member "read", "write" or "none" on
    // a project (Settings -> Identity & Authorization), stored on the member's
    // profile as projectAccess[projectId]. The app hid projects accordingly,
    // but nothing here enforced it: any member of the org could read or write
    // every project's costs, bills and logs straight through the API. These
    // helpers make the database agree with the screen.
    //
    //   Owner / Admin        every project
    //   the project's owner  their own project
    //   everyone else        only as granted
    //
    // projectAccess and role cannot be changed by the user themselves (see
    // /users below), so neither can be self-granted. The project DOCUMENT stays
    // readable by any member: the list query cannot be filtered by a rule, and
    // it holds only the name, code and dates.
    // ---------------------------------------------------------------------
    function myProjectAccess(projectId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('projectAccess', {}).get(projectId, 'none');
    }
    function ownsProject(orgId, projectId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projectId)).data.get('ownerId', '') == request.auth.uid;
    }
    function canReadProject(orgId, projectId) {
      return isOrgMember(orgId) && (
        hasAnyRole(['Admin', 'Owner'])
        || myProjectAccess(projectId) in ['read', 'write']
        || ownsProject(orgId, projectId)
      );
    }
    function canWriteProject(orgId, projectId) {
      return isOrgMember(orgId) && (
        hasAnyRole(['Admin', 'Owner'])
        || myProjectAccess(projectId) == 'write'
        || ownsProject(orgId, projectId)
      );
    }
    // The collections handled by the generic project rule (the audited ones
    // are matched explicitly below).
    function isGenericCollection(collection) {
      return collection != 'dailyLogs' && collection != 'purchase_orders'
        && collection != 'goodsReceiptNotes' && collection != 'system'
        && collection != 'ledger' && collection != 'ra_bills'
        && collection != 'labor_rate_cards' && collection != 'client_payments'
        && collection != 'documents' && collection != 'estimates'
        && collection != 'audit_logs';
    }

    // ---------------------------------------------------------------------
    // Plan project limit.
    //
    // The app checks the limit before creating a project, but nothing here
    // did, so an Owner or Admin could create unlimited projects on a
    // one-project plan by writing directly. Rules cannot count documents;
    // organizations/{orgId}.projectCount is maintained by a Cloud Function
    // (functions/src/projects/projectCount.ts) and is not client-writable.
    //
    //   no numeric includedProjects  -> uncapped (Enterprise, grandfathered)
    //   no projectCount yet          -> allowed (orgs from before the counter;
    //                                   it appears on their next project write)
    //   otherwise                    -> count must be below the plan's cap plus
    //                                   any purchased slots still inside their
    //                                   30 days
    //
    // The counter lags a create by a moment, so several creates fired in one
    // burst can slip past. That is a narrow gap, and nothing like the open
    // door this closes.
    // ---------------------------------------------------------------------
    function underProjectCap(orgId) {
      let o = get(/databases/$(database)/documents/organizations/$(orgId)).data;
      let cap = o.get('includedProjects', null);
      let count = o.get('projectCount', null);
      let slots = o.get('slotsExpireAt', 0) > request.time.toMillis() ? o.get('purchasedSlots', 0) : 0;
      // Recurring slot subscriptions, summarised by the billing functions
      // (functions/src/slotSubs.ts) because a rule cannot sum the map.
      let recurring = o.get('recurringSlotsUntil', 0) > request.time.toMillis() ? o.get('recurringSlots', 0) : 0;
      return !(cap is number) || !(count is number) || count < cap + slots + recurring;
    }

    // =====================================================================
    // Organizations (multi-tenant tree)
    // =====================================================================
    match /organizations/{orgId} {
      // Members read their org. An UNCLAIMED org is readable by any signed-in
      // user so the claim UI can detect it and offer the claim.
      //
      // `get` and `list` are SEPARATE on purpose -- `allow read` covers both,
      // and that leaked every tenant. While a QUERY is evaluated there is no
      // document in scope, so `resource.data` is unset and
      // `thisOrgMembers()` returns its `{}` default; `thisOrgUnclaimed()` is
      // then true for every candidate document and the whole collection opens
      // to any signed-in user. Fetching one org by id is denied correctly --
      // only the collection scan was wrong, which is why this never showed up
      // in the app. A free signup could read every customer's companyName,
      // plan, subscriptionStatus and members map (each member's uid and role).
      //
      // Nothing queries this collection: the client reads organizations only by
      // document id (7 call sites), and the claim UI likewise looks up a known
      // id, so it still works through `get`. Keep `list` closed -- if a feature
      // ever needs to list orgs, it belongs in a callable that filters by
      // membership server-side, not in a rule that cannot see the document.
      // scripts/emulator-tenant-probe.mjs covers this.
      allow get: if isMemberOfThisOrg() || (request.auth != null && thisOrgUnclaimed());
      allow list: if false;
      // Brand-new org (future self-serve onboarding): the creator must seed
      // themselves as Owner.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(orgClientKeys())
        && (request.auth.uid in request.resource.data.get('members', {}))
        && request.resource.data.members[request.auth.uid] == 'Owner';
      // A one-time claim, or an existing admin-member editing org settings
      // (company name, GSTIN, membership changes) -- never billing state.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(orgClientKeys())
        && (isValidClaim() || (isMemberOfThisOrg() && isAdminOrManager()));
      allow delete: if false;

      // AI usage meters — written only by Cloud Functions (Admin SDK); members
      // may read their own org's usage for display.
      match /usage/{month} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      // ---- Organisation master data ----
      // Shared across every project in the org, so it is created once and
      // reused. Any member may read (pickers need it); only an Admin or
      // Manager may change a master.
      match /wbs_templates/{templateId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgMember(orgId) && isAdminOrManager();
      }

      // Vendor master — the supplier's DEFINITION only (name, GSTIN, contact).
      // Balances, ledgers and purchase orders stay project-scoped; a project
      // vendor is created by copying from here, so the financial paths are
      // untouched by this collection.
      match /vendors/{vendorId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgMember(orgId) && isAdminOrManager();
      }

      // Material master — the item's DEFINITION only (name, code, unit, HSN,
      // GST rate). Stock quantity and landed cost stay project-scoped, because
      // material exists at a site, not in an organisation.
      match /materials/{materialId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgMember(orgId) && isAdminOrManager();
      }

      match /projects/{projectId} {
        allow read: if isOrgMember(orgId);
        // Creating or editing the project itself is a role decision, not a
        // per-project grant (a project being created has no grants yet).
        // Creating is also limited by the plan: see underProjectCap.
        allow create: if isOrgMember(orgId) && isAdminOrManager() && underProjectCap(orgId);
        allow update, delete: if isOrgMember(orgId) && isAdminOrManager();

        // Generic project sub-collections (tasks, inventory, suppliers, costs,
        // materials, equipment, dailyPlans, vendor_bills, …). The financial /
        // audited collections below are matched explicitly and excluded here.
        match /{collection}/{docId} {
          allow read: if canReadProject(orgId, projectId) && isGenericCollection(collection);
          allow write: if canWriteProject(orgId, projectId) && isGenericCollection(collection);
        }
        match /estimates/{estimateId} {
          allow read: if canReadProject(orgId, projectId);
          allow create: if canWriteProject(orgId, projectId);
          allow update: if canWriteProject(orgId, projectId) && (
            request.resource.data.status == resource.data.status || isAdminOrManager()
          );
          allow delete: if canWriteProject(orgId, projectId) && isAdminOrManager();
        }
        match /audit_logs/{auditId} {
          allow read: if canReadProject(orgId, projectId) && isAdminOrManager();
          allow create: if canWriteProject(orgId, projectId);
          allow update, delete: if false;
        }
        match /documents/{docId} {
          allow read: if canReadProject(orgId, projectId);
          allow create: if canWriteProject(orgId, projectId);
          allow update, delete: if canWriteProject(orgId, projectId) && isAdminOrManager();
        }
        match /client_payments/{paymentId} {
          allow read: if canReadProject(orgId, projectId);
          allow write: if canWriteProject(orgId, projectId) && isAdminOrManager();
        }
        match /ra_bills/{billId} {
          allow read: if canReadProject(orgId, projectId);
          allow write: if canWriteProject(orgId, projectId) && isAdminOrManager();
        }
        match /labor_rate_cards/{cardId} {
          allow read: if canReadProject(orgId, projectId);
          allow write: if canWriteProject(orgId, projectId) && isAdminOrManager();
        }
        match /ledger/{ledgerId} {
          allow read: if canReadProject(orgId, projectId);
          allow create: if canWriteProject(orgId, projectId) && (
            request.resource.data.referenceType != 'PAYMENT' || isAdminOrManager()
          );
          allow update, delete: if canWriteProject(orgId, projectId) && isAdminOrManager();
        }
        match /system/{docId} {
          allow read: if canReadProject(orgId, projectId);
          allow write: if canWriteProject(orgId, projectId);
        }
        match /goodsReceiptNotes/{grnId} {
          allow read: if canReadProject(orgId, projectId);
          allow create: if canWriteProject(orgId, projectId);
          allow update, delete: if canWriteProject(orgId, projectId) && (
            isAdminOrManager() || isSiteEngineer() ||
            resource.data.createdByUid == request.auth.uid
          );
        }
        match /purchase_orders/{poId} {
          allow read: if canReadProject(orgId, projectId);
          allow create: if canWriteProject(orgId, projectId)
            && request.resource.data.status == 'Draft'
            && request.resource.data.createdByUid == request.auth.uid;
          allow update: if canWriteProject(orgId, projectId) && (
            isAdminOrManager() || isSiteEngineer() ||
            resource.data.createdByUid == request.auth.uid
          );
          allow delete: if canWriteProject(orgId, projectId) && (
            isAdminOrManager() ||
            (resource.data.createdByUid == request.auth.uid && resource.data.status == 'Draft')
          );
        }
        match /dailyLogs/{logId} {
          allow read: if canReadProject(orgId, projectId);
          allow create: if canWriteProject(orgId, projectId) && (isSiteEngineer() || isAdminOrManager());
          allow update: if canWriteProject(orgId, projectId) && (
            isAdminOrManager() ||
            (isSiteEngineer() && resource.data.createdByUid == request.auth.uid)
          );
          allow delete: if canWriteProject(orgId, projectId) && (
            isAdminOrManager() ||
            (isSiteEngineer() && resource.data.createdByUid == request.auth.uid)
          );
        }
      }
    }

    // =====================================================================
    // Legacy single-tenant tree (/projects/*), for data written before the
    // org path existed. Auth-gated exactly as before — modeled explicitly here
    // so the recursive `{path=**}` fallbacks (which would have OR-ed open the
    // org tree above and defeated tenant isolation) can be removed entirely.
    // =====================================================================
    match /projects/{projectId} {
      // Legacy single-tenant data, superseded by the organizations/ tree and
      // retained only as a post-migration backup. Locked to DENY all client
      // access so it can't be read or written across tenants. Cloud Functions
      // (Admin SDK) and the console still reach it for backup/cleanup.
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // =====================================================================
    // Top-level collections
    // =====================================================================
    match /errorLogs/{logId} {
      allow create: if request.auth != null;
    }

    // Tenant-isolated: a user may read their OWN profile, or another user's
    // profile only when both belong to the SAME organization. This closes the
    // cross-org leak where any signed-in user could read every user document.
    // (Cloud Functions use the Admin SDK and bypass these rules.)
    //
    // "Same organization" is checked against the org's own members map, not
    // just the reader's currentOrgId: that field is the reader's to write, and
    // pointing it at another org used to open that org's profiles to them.
    function readerOrg() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('currentOrgId', '');
    }
    function sharesReaderOrg() {
      return readerOrg() != ''
        && isOrgMember(readerOrg())
        && resource.data.get('currentOrgId', '') == readerOrg();
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || sharesReaderOrg()
      );
      // Users create their own profile on first sign-in -- as a Viewer, or as
      // whatever role a verified custom claim already gives them. Roles are
      // granted by Cloud Functions (createOrganization, acceptInvite) or by an
      // admin of the same org, never by the user.
      allow create: if request.auth != null && request.auth.uid == userId
        && (request.resource.data.get('role', 'Viewer') == 'Viewer'
            || request.resource.data.get('role', '') == request.auth.token.get('role', ''))
        && !('projectAccess' in request.resource.data)
        && (request.resource.data.get('currentOrgId', '') == ''
            || isOrgMember(request.resource.data.currentOrgId));
      // Self edits their own doc EXCEPT the fields that grant power. `role`
      // was self-editable, and every rule above trusts it: a Site Engineer
      // could write role "Owner" and become an Admin of their org. currentOrgId
      // may only point at an org that lists them as a member.
      //
      // An admin may edit a member of their OWN org: role, project access, and
      // unlinking a Telegram chat -- nothing else on someone else's profile.
      allow update: if request.auth != null && (
        (request.auth.uid == userId
          && !changed().hasAny(['role', 'projectAccess'])
          && (!changed().hasAny(['currentOrgId'])
              || request.resource.data.get('currentOrgId', '') == ''
              || isOrgMember(request.resource.data.currentOrgId)))
        ||
        (request.auth.uid != userId
          && isAdminOrManager()
          && sharesReaderOrg()
          && changed().hasOnly(['role', 'projectAccess', 'telegramChatId', 'telegramLinkedAt']))
      );
      allow delete: if false;
    }

    // Link codes bind a Telegram chat to a Sitetru account. Redemption
    // (functions/src/telegram/auth.ts) authenticates on the code alone, so a
    // code is a bearer credential: anyone who can read one can bind their own
    // Telegram chat to that account. It must therefore be readable only by the
    // user it was minted for -- a blanket `request.auth != null` here let any
    // signed-in user list unused codes and take over another account's bot.
    match /bot_link_codes/{code} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      // Only ever for yourself. Minting a code carrying someone else's uid and
      // then redeeming it is the same takeover by another route.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      // The webhook marks codes used through the Admin SDK, which bypasses
      // these rules. No client needs to write one.
      allow update, delete: if false;
    }
    // Only the Cloud Functions (Admin SDK) ever touch these — deny all clients.
    match /bot_rate_limits/{chatId} {
      allow read, write: if false;
    }
    match /bot_sessions/{sessionId} {
      allow read, write: if false;
    }
    // Invite codes are created and redeemed only by Cloud Functions (Admin SDK,
    // which bypasses these rules). No client should read or write them directly.
    match /org_invites/{code} {
      allow read, write: if false;
    }
    // App config (e.g. the Resend API key) is written/read only by Cloud
    // Functions via the Admin SDK. Never expose it to clients.
    match /app_config/{doc} {
      allow read, write: if false;
    }

    // NOTE: the recursive `/{path=**}/…` fallback rules were intentionally
    // removed. Because Firestore grants access if ANY matching rule allows it,
    // those auth-only fallbacks matched org-nested paths too and would have
    // bypassed the membership checks above. Every collection is now modeled
    // explicitly under its tenant tree.
  }
}
