rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Role helpers (unchanged semantics): a caller has a role if either their
    // auth-token custom claim OR their users/{uid} profile carries that role.
    // ---------------------------------------------------------------------
    function hasAnyRole(roles) {
      return request.auth != null && (
        request.auth.token.role in roles ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles
      );
    }
    function isAdminOrManager() {
      return hasAnyRole(['Admin', 'Project Manager', 'Project Director', 'Owner']);
    }
    function isSiteEngineer() {
      return hasAnyRole(['Site Engineer']);
    }

    // ---------------------------------------------------------------------
    // Multi-tenant isolation.
    //
    // Membership lives as a map on the org document: members: { <uid>: <role> }.
    // A caller may only touch an org's data if their uid is a key in that map.
    // This is the wall between customers — without it, any signed-in user could
    // read or write ANY organization's data.
    //
    // Bootstrapping: an org with no members yet may be "claimed" once — the
    // claimer writes ONLY themselves in as 'Owner'. After that, only members can
    // change membership (via an admin-member settings write). This lets the
    // first owner seed themselves without a console edit and without leaving the
    // org open to a stranger claiming an already-owned org.
    // ---------------------------------------------------------------------
    function orgMembersById(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.get('members', {});
    }
    function isOrgMember(orgId) {
      return request.auth != null && (request.auth.uid in orgMembersById(orgId));
    }
    // Variants that read the org doc currently in scope (rules ON the org doc
    // itself) so we don't pay for an extra get().
    function thisOrgMembers() {
      return resource.data.get('members', {});
    }
    function isMemberOfThisOrg() {
      return request.auth != null && (request.auth.uid in thisOrgMembers());
    }
    function thisOrgUnclaimed() {
      return thisOrgMembers().size() == 0;
    }
    function isValidClaim() {
      return request.auth != null
        && thisOrgUnclaimed()
        && request.resource.data.get('members', {}).keys().hasOnly([request.auth.uid])
        && (request.auth.uid in request.resource.data.get('members', {}))
        && request.resource.data.members[request.auth.uid] == 'Owner';
    }

    // =====================================================================
    // Organizations (multi-tenant tree)
    // =====================================================================
    match /organizations/{orgId} {
      // Members read their org. An UNCLAIMED org is readable by any signed-in
      // user so the claim UI can detect it and offer the claim.
      allow read: if isMemberOfThisOrg() || (request.auth != null && thisOrgUnclaimed());
      // Brand-new org (future self-serve onboarding): the creator must seed
      // themselves as Owner.
      allow create: if request.auth != null
        && (request.auth.uid in request.resource.data.get('members', {}))
        && request.resource.data.members[request.auth.uid] == 'Owner';
      // A one-time claim, or an existing admin-member editing org settings
      // (company name, GSTIN, membership changes).
      allow update: if isValidClaim() || (isMemberOfThisOrg() && isAdminOrManager());
      allow delete: if false;

      // AI usage meters — written only by Cloud Functions (Admin SDK); members
      // may read their own org's usage for display.
      match /usage/{month} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /projects/{projectId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgMember(orgId) && isAdminOrManager();

        // Generic project sub-collections (tasks, inventory, suppliers, costs,
        // materials, equipment, dailyPlans, vendor_bills, …). The financial /
        // audited collections below are matched explicitly and excluded here.
        match /{collection}/{docId} {
          allow read, write: if isOrgMember(orgId)
            && collection != 'dailyLogs' && collection != 'purchase_orders'
            && collection != 'goodsReceiptNotes' && collection != 'system'
            && collection != 'ledger' && collection != 'ra_bills'
            && collection != 'labor_rate_cards' && collection != 'client_payments'
            && collection != 'documents' && collection != 'estimates'
            && collection != 'audit_logs';
        }
        match /estimates/{estimateId} {
          allow read, create: if isOrgMember(orgId);
          allow update: if isOrgMember(orgId) && (
            request.resource.data.status == resource.data.status || isAdminOrManager()
          );
          allow delete: if isOrgMember(orgId) && isAdminOrManager();
        }
        match /audit_logs/{auditId} {
          allow read: if isOrgMember(orgId) && isAdminOrManager();
          allow create: if isOrgMember(orgId);
          allow update, delete: if false;
        }
        match /documents/{docId} {
          allow read, create: if isOrgMember(orgId);
          allow update, delete: if isOrgMember(orgId) && isAdminOrManager();
        }
        match /client_payments/{paymentId} {
          allow read: if isOrgMember(orgId);
          allow write: if isOrgMember(orgId) && isAdminOrManager();
        }
        match /ra_bills/{billId} {
          allow read: if isOrgMember(orgId);
          allow write: if isOrgMember(orgId) && isAdminOrManager();
        }
        match /labor_rate_cards/{cardId} {
          allow read: if isOrgMember(orgId);
          allow write: if isOrgMember(orgId) && isAdminOrManager();
        }
        match /ledger/{ledgerId} {
          allow read: if isOrgMember(orgId);
          allow create: if isOrgMember(orgId) && (
            request.resource.data.referenceType != 'PAYMENT' || isAdminOrManager()
          );
          allow update, delete: if isOrgMember(orgId) && isAdminOrManager();
        }
        match /system/{docId} {
          allow read, write: if isOrgMember(orgId);
        }
        match /goodsReceiptNotes/{grnId} {
          allow read: if isOrgMember(orgId);
          allow create: if isOrgMember(orgId);
          allow update, delete: if isOrgMember(orgId) && (
            isAdminOrManager() || isSiteEngineer() ||
            resource.data.createdByUid == request.auth.uid
          );
        }
        match /purchase_orders/{poId} {
          allow read: if isOrgMember(orgId);
          allow create: if isOrgMember(orgId)
            && request.resource.data.status == 'Draft'
            && request.resource.data.createdByUid == request.auth.uid;
          allow update: if isOrgMember(orgId) && (
            isAdminOrManager() || isSiteEngineer() ||
            resource.data.createdByUid == request.auth.uid
          );
          allow delete: if isOrgMember(orgId) && (
            isAdminOrManager() ||
            (resource.data.createdByUid == request.auth.uid && resource.data.status == 'Draft')
          );
        }
        match /dailyLogs/{logId} {
          allow read: if isOrgMember(orgId);
          allow create: if isOrgMember(orgId) && (isSiteEngineer() || isAdminOrManager());
          allow update: if isOrgMember(orgId) && (
            isAdminOrManager() ||
            (isSiteEngineer() && resource.data.createdByUid == request.auth.uid)
          );
          allow delete: if isOrgMember(orgId) && (
            isAdminOrManager() ||
            (isSiteEngineer() && resource.data.createdByUid == request.auth.uid)
          );
        }
      }
    }

    // =====================================================================
    // Legacy single-tenant tree (/projects/*), for data written before the
    // org path existed. Auth-gated exactly as before — modeled explicitly here
    // so the recursive `{path=**}` fallbacks (which would have OR-ed open the
    // org tree above and defeated tenant isolation) can be removed entirely.
    // =====================================================================
    match /projects/{projectId} {
      allow read, write: if request.auth != null;
      match /{collection}/{docId} {
        allow read, write: if request.auth != null
          && collection != 'dailyLogs' && collection != 'purchase_orders'
          && collection != 'goodsReceiptNotes' && collection != 'system'
          && collection != 'ledger' && collection != 'ra_bills'
          && collection != 'labor_rate_cards' && collection != 'client_payments'
          && collection != 'documents' && collection != 'estimates'
          && collection != 'audit_logs';
      }
      match /estimates/{estimateId} {
        allow read, create: if request.auth != null;
        allow update: if request.auth != null && (
          request.resource.data.status == resource.data.status || isAdminOrManager()
        );
        allow delete: if request.auth != null && isAdminOrManager();
      }
      match /audit_logs/{auditId} {
        allow read: if request.auth != null && isAdminOrManager();
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
      match /documents/{docId} {
        allow read, create: if request.auth != null;
        allow update, delete: if request.auth != null && isAdminOrManager();
      }
      match /client_payments/{paymentId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdminOrManager();
      }
      match /ra_bills/{billId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdminOrManager();
      }
      match /labor_rate_cards/{cardId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdminOrManager();
      }
      match /ledger/{ledgerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && (
          request.resource.data.referenceType != 'PAYMENT' || isAdminOrManager()
        );
        allow update, delete: if request.auth != null && isAdminOrManager();
      }
      match /system/{docId} {
        allow read, write: if request.auth != null;
      }
      match /goodsReceiptNotes/{grnId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && (
          isAdminOrManager() || isSiteEngineer() ||
          resource.data.createdByUid == request.auth.uid
        );
      }
      match /purchase_orders/{poId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.status == 'Draft'
          && request.resource.data.createdByUid == request.auth.uid;
        allow update: if request.auth != null && (
          isAdminOrManager() || isSiteEngineer() ||
          resource.data.createdByUid == request.auth.uid
        );
        allow delete: if request.auth != null && (
          isAdminOrManager() ||
          (resource.data.createdByUid == request.auth.uid && resource.data.status == 'Draft')
        );
      }
      match /dailyLogs/{logId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && (isSiteEngineer() || isAdminOrManager());
        allow update: if request.auth != null && (
          isAdminOrManager() ||
          (isSiteEngineer() && resource.data.createdByUid == request.auth.uid)
        );
        allow delete: if request.auth != null && (
          isAdminOrManager() ||
          (isSiteEngineer() && resource.data.createdByUid == request.auth.uid)
        );
      }
    }

    // =====================================================================
    // Top-level collections
    // =====================================================================
    match /errorLogs/{logId} {
      allow create: if request.auth != null;
    }

    // Tenant-isolated: a user may read their OWN profile, or another user's
    // profile only when both belong to the SAME organization. This closes the
    // cross-org leak where any signed-in user could read every user document.
    // (Cloud Functions use the Admin SDK and bypass these rules.)
    function readerOrg() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('currentOrgId', '');
    }
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (readerOrg() != '' && resource.data.get('currentOrgId', '') == readerOrg())
      );
      // Users create their own profile on first sign-in.
      allow create: if request.auth != null && request.auth.uid == userId;
      // Self edits anything on their own doc; an admin may edit a member of
      // their OWN org (e.g. role / project access).
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (isAdminOrManager() && readerOrg() != '' && resource.data.get('currentOrgId', '') == readerOrg())
      );
      allow delete: if false;
    }

    // Link codes: created client-side; redeemed by the Telegram webhook via the
    // Admin SDK (which bypasses these rules).
    match /bot_link_codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (request.resource.data.userId == request.auth.uid || isAdminOrManager());
      allow update, delete: if request.auth != null && isAdminOrManager();
    }
    // Only the Cloud Functions (Admin SDK) ever touch these — deny all clients.
    match /bot_rate_limits/{chatId} {
      allow read, write: if false;
    }
    match /bot_sessions/{sessionId} {
      allow read, write: if false;
    }
    // Invite codes are created and redeemed only by Cloud Functions (Admin SDK,
    // which bypasses these rules). No client should read or write them directly.
    match /org_invites/{code} {
      allow read, write: if false;
    }

    // NOTE: the recursive `/{path=**}/…` fallback rules were intentionally
    // removed. Because Firestore grants access if ANY matching rule allows it,
    // those auth-only fallbacks matched org-nested paths too and would have
    // bypassed the membership checks above. Every collection is now modeled
    // explicitly under its tenant tree.
  }
}
