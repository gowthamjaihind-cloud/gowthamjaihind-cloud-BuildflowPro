{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "build:demo": "VITE_DEMO=1 vite build --outDir dist-demo",
    "verify:no-demo": "node scripts/verify-no-demo.mjs",
    "i18n:report": "node scripts/i18n-report.mjs",
    "video": "node marketing/video/build.mjs both",
    "video:preview": "PREVIEW=1 node marketing/video/build.mjs",
    "capture:screens": "node marketing/capture/capture-screens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:demo:hosted": "VITE_DEMO=1 vite build --outDir dist-demo --base=/demo/",
    "walkthrough": "node marketing/walkthrough/record.mjs",
    "film:launch": "node marketing/films/build-voice.mjs launch && npm run film:launch:render",
    "film:launch:render": "cd marketing/remotion && npx remotion render Launch out/sitetru-launch-silent.mp4 --browser-executable=${CHROME_HEADLESS_SHELL:-/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell} --concurrency=4 --jpeg-quality=95 && node ../films/mix.mjs launch out/sitetru-launch-silent.mp4 out/sitetru-launch.mp4",
    "film:walkthrough": "node marketing/films/build-voice.mjs walkthrough && npm run walkthrough",
    "voice:check": "python3 marketing/voice/pronounce.py",
    "brand:check": "node marketing/brand.test.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@google/genai": "^1.29.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "^8.55.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.10.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.4.0",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-background-sync": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "playwright-core": "^1.62.1",
    "vitest": "^3.2.7"
  }
}
